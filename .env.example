# 复制为 .env 后按需修改。生产环境的边界校验见 config.py::require_production_boundaries。
# ---- 基础 ----
DIP_APP_NAME=数据集成平台控制面
DIP_ENVIRONMENT=local
DIP_API_PREFIX=/api/v1

# ---- 身份边界 ----
# local 开发可用 dev-header；environment=prod/production 时强制 trusted-gateway。
# dev-header 模式下，调用者身份由请求头 X-Actor-Id 携带，取值是 users.id（UUID）。
# 获取方式：POST /api/v1/bootstrap 返回首位管理员的 user.id；再用
# PUT /api/v1/projects/{project_id}/members 添加成员并取得各自的 user_id。
DIP_AUTH_MODE=dev-header
# 可信网关 HMAC 共享密钥，至少 32 字节；auth_mode=trusted-gateway 时必填。
DIP_GATEWAY_HMAC_SECRET=
DIP_GATEWAY_MAX_CLOCK_SKEW_SECONDS=60
# 首次初始化是**一次性**动作（FR-05）：仅在创建首位管理员时临时置 true，
# 完成后必须关闭本开关并撤销 Token。因此默认 false，且置 true 时 Token 不得为空。
DIP_BOOTSTRAP_ENABLED=false
DIP_BOOTSTRAP_TOKEN=

# ---- 状态与消息 ----
DIP_DATABASE_URL=postgresql+asyncpg://dip:dip@localhost:5432/dip
DIP_CHECKPOINT_DATABASE_URL=postgresql://dip_checkpoint:dip_checkpoint@localhost:5432/dip_checkpoint
# 宿主 6379 常被本机原生 Redis 占用，compose 把 redis 容器发布到 16379（见 infra/compose.yaml）。
DIP_REDIS_URL=redis://localhost:16379/0

# ---- 可观测 ----
DIP_OTEL_ENABLED=false
DIP_OTEL_SERVICE_NAME=data-integration-platform
DIP_OTEL_TRACES_ENDPOINT=
DIP_OTEL_EXPORT_TIMEOUT_SECONDS=10
DIP_OTEL_TRACE_SAMPLE_RATIO=1.0

# ---- Harness 运行预算硬上限（作业开始后不得扩权）----
DIP_HARNESS_RUNTIME_MAX_RECORDS=10000000
DIP_HARNESS_RUNTIME_MAX_BYTES=10737418240
DIP_HARNESS_RUNTIME_TIMEOUT_SECONDS=3600
DIP_HARNESS_RUNTIME_MAX_OUTPUT_RATIO=2.0
DIP_HARNESS_RUNTIME_MAX_REJECT_RATE=0.5
DIP_HARNESS_RUNTIME_MINIMUM_QUALITY_ROWS=100
DIP_HARNESS_RUNTIME_WARNING_RATIO=0.8

# ---- Harness 协议时效 ----
DIP_HARNESS_PREPARATION_TTL_SECONDS=86400
DIP_HARNESS_CAPABILITY_TTL_SECONDS=300
DIP_HARNESS_POLICY_BUNDLE_VERSION=harness-v1-20261016

# ---- 受管文件资产 ----
DIP_FILE_ASSET_ROOT=var/file-assets
DIP_FILE_ASSET_MAX_BYTES=26214400
DIP_FILE_ASSET_MAX_ROWS=100000
