# 复制为 .env 后按需修改。生产环境的边界校验见 config.py::require_production_boundaries。
# ---- 基础 ----
DIP_APP_NAME=数据集成平台控制面
DIP_ENVIRONMENT=local
DIP_API_PREFIX=/api/v1

# ---- 身份边界 ----
# local 开发可用 dev-header；environment=prod/production 时强制 trusted-gateway。
# dev-header 模式下，调用者身份由请求头 X-Actor-Id 携带，取值是 users.id（UUID）。
# 获取方式：POST /api/v1/bootstrap 返回首位管理员的 user.id；再用
# PUT /api/v1/projects/{project_id}/members 添加成员并取得各自的 user_id。
DIP_AUTH_MODE=dev-header
# 可信网关 HMAC 共享密钥，至少 32 字节；auth_mode=trusted-gateway 时必填。
DIP_GATEWAY_HMAC_SECRET=
DIP_GATEWAY_MAX_CLOCK_SKEW_SECONDS=60
# 首次初始化是**一次性**动作（FR-05）：仅在创建首位管理员时临时置 true，
# 完成后必须关闭本开关并撤销 Token。因此默认 false，且置 true 时 Token 不得为空。
DIP_BOOTSTRAP_ENABLED=false
DIP_BOOTSTRAP_TOKEN=

# ---- 状态与消息 ----
# 写 127.0.0.1 而不是 localhost：Windows 优先解析 IPv6 `::1`，而 Docker 只发布 IPv4，
# 走 localhost 每次连接都要先等 `::1` 失败再回退（实测 Redis 差 250 倍，且无超时的客户端会挂住）。
DIP_DATABASE_URL=postgresql+asyncpg://dip:dip@127.0.0.1:5432/dip
DIP_CHECKPOINT_DATABASE_URL=postgresql://dip_checkpoint:dip_checkpoint@127.0.0.1:5432/dip_checkpoint
# 宿主 6379 常被本机原生 Redis 占用，compose 把 redis 容器发布到 16379（见 infra/compose.yaml）。
DIP_REDIS_URL=redis://127.0.0.1:16379/0

# ---- 可观测 ----
DIP_OTEL_ENABLED=false
DIP_OTEL_SERVICE_NAME=data-integration-platform
DIP_OTEL_TRACES_ENDPOINT=
DIP_OTEL_EXPORT_TIMEOUT_SECONDS=10
DIP_OTEL_TRACE_SAMPLE_RATIO=1.0

# ---- 凭据存储（T-14）----
# fernet-db：本地加密库，需配主密钥；vault-kv-v2：企业 Secret Provider。
DIP_SECRET_PROVIDER=fernet-db
# 生成方式：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 生产环境使用 fernet-db 时必须配置；本地留空表示「未就绪」，写凭据时失败关闭。
DIP_SECRET_MASTER_KEY=
DIP_VAULT_ADDRESS=
DIP_VAULT_TOKEN=
DIP_VAULT_KV_MOUNT=secret
DIP_VAULT_PATH_PREFIX=dip/connections
DIP_VAULT_TIMEOUT_SECONDS=10
DIP_VAULT_VERIFY_TLS=true
# 轮换回退保留期：激活后多久内仍可回到旧凭据（FR-20）。
DIP_SECRET_ROTATION_ROLLBACK_DAYS=7

# ---- 凭据到期告警（FR-22）----
DIP_CREDENTIAL_ALERT_SCAN_INTERVAL_SECONDS=3600
DIP_CREDENTIAL_ALERT_WARNING_COOLDOWN_HOURS=24
DIP_CREDENTIAL_ALERT_OVERDUE_COOLDOWN_HOURS=6
# 配置 Webhook 后必须同时放行其主机（白名单为空=全部拒绝），生产环境还必须配签名密钥。
DIP_CREDENTIAL_ALERT_WEBHOOK_URL=
DIP_CREDENTIAL_ALERT_WEBHOOK_SIGNING_SECRET=
DIP_CREDENTIAL_ALERT_WEBHOOK_TIMEOUT_SECONDS=10
DIP_CREDENTIAL_ALERT_WEBHOOK_ALLOWED_HOSTS=

# ---- 元数据探查（T-10 ~ T-13）----
# Profile 是「有时效的事实」，不是永久 Schema。
DIP_PROFILE_TTL_SECONDS=86400
DIP_PROBE_SAMPLE_LIMIT_DEFAULT=20
DIP_PROBE_SAMPLE_LIMIT_MAX=100
DIP_PROBE_STATEMENT_TIMEOUT_SECONDS=15

# ---- 远端文件探查（T-16 对象存储 / HDFS）----
# 只做前缀范围采样，严禁全量下载。
DIP_REMOTE_FILE_SAMPLE_BYTES=8388608

# ---- REST API 数据源（T-17）----
# 出口主机白名单，逗号分隔；留空表示全部拒绝（失败关闭）。
# 支持 `host` 或 `host:port` 两种写法。
DIP_REST_API_ALLOWED_HOSTS=
DIP_REST_API_TIMEOUT_SECONDS=15
DIP_REST_API_MAX_SAMPLE_BYTES=4194304

# ---- 生成与模型（T-18 ~ T-33）----
# OpenAI 兼容协议；未配置时生成能力「未就绪」（/health 会明确报告，不静默失败）。
DIP_GENERATION_BACKEND=direct
DIP_LLM_BASE_URL=
DIP_LLM_API_KEY=
DIP_LLM_MODEL=
DIP_LLM_REQUEST_TIMEOUT_SECONDS=180
# 候选总量 = 首次 1 份 + 修复次数；PRD 决策 Q1 定档为 3 份，三类失败共享同一计数。
DIP_MAX_ENTERPRISE_REPAIR_ATTEMPTS=2
# 逐行 LLM Transform：默认严格关闭；开启必须同时配密钥与出口白名单（FR-33）。
DIP_ROW_LLM_TRANSFORM_ENABLED=false
DIP_ROW_LLM_API_KEY=
DIP_ROW_LLM_ALLOWED_API_HOSTS=
DIP_ROW_LLM_MAX_ROWS_PER_SECOND=10

# ---- 数据面引擎（T-21）----
DIP_SEATUNNEL_API_URL=http://127.0.0.1:8080
DIP_SEATUNNEL_TIMEZONE=UTC
DIP_SEATUNNEL_CHECK_TIMEOUT_SECONDS=60

# ---- 制品存储（T-22）----
DIP_ARTIFACT_ROOT=var/artifacts

# ---- 调度（T-23）----
# 触发时刻过去超过这个秒数才算失火，按策略处理（PRD 决策 Q5：秒数属可调实现参数）。
DIP_SCHEDULE_MISFIRE_GRACE_SECONDS=120

# ---- Harness 运行预算硬上限（作业开始后不得扩权）----
DIP_HARNESS_RUNTIME_MAX_RECORDS=10000000
DIP_HARNESS_RUNTIME_MAX_BYTES=10737418240
DIP_HARNESS_RUNTIME_TIMEOUT_SECONDS=3600
DIP_HARNESS_RUNTIME_MAX_OUTPUT_RATIO=2.0
DIP_HARNESS_RUNTIME_MAX_REJECT_RATE=0.5
DIP_HARNESS_RUNTIME_MINIMUM_QUALITY_ROWS=100
DIP_HARNESS_RUNTIME_WARNING_RATIO=0.8

# ---- Harness 协议时效 ----
DIP_HARNESS_PREPARATION_TTL_SECONDS=86400
DIP_HARNESS_CAPABILITY_TTL_SECONDS=300
DIP_HARNESS_POLICY_BUNDLE_VERSION=harness-v1-20261016

# ---- Harness 分离签名（T-28 / FR-45）----
# 私钥只给签发方（API / 授权服务），执行方（Worker）只挂公钥映射 —— 这样 Worker
# 在结构上就签不出能力令牌。两者都是 base64url 的裸 32 字节。
# 生成：uv run python -c "from data_integration_platform.infrastructure.ed25519_signing import generate_keypair; print(generate_keypair())"
DIP_HARNESS_SIGNING_KEY_ID=harness-local-1
DIP_HARNESS_SIGNING_PRIVATE_KEY=
# 轮换期间新旧两把都写上，旧令牌才验得过：`key_id:密钥,key_id:密钥`
DIP_HARNESS_SIGNING_PUBLIC_KEYS=

# ---- 事务 Outbox（T-30 / FR-47）----
# 租约到期后未投递的命令重新可领；重试到上限即判失败，不再无限重投。
DIP_HARNESS_OUTBOX_LEASE_SECONDS=60
DIP_HARNESS_OUTBOX_MAX_ATTEMPTS=5

# ---- 受管文件资产 ----
DIP_FILE_ASSET_ROOT=var/file-assets
DIP_FILE_ASSET_MAX_BYTES=26214400
DIP_FILE_ASSET_MAX_ROWS=100000
